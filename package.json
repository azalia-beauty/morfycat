{
  "name": "morfy-app",
  "productName": "morfy",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Модульное приложение в стиле хакерского HUD для Windows и Android — сделано Morphin",
  "author": "Morphin",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "win:dev": "vite build && electron .",
    "win:build": "vite build && electron-builder --win --publish never --config electron-builder.config.cjs",
    "android:add": "vite build && cap add android && node scripts/patch-android.mjs && cap sync android",
    "android:sync": "vite build && cap sync android && node scripts/patch-android.mjs",
    "release": "node scripts/release.mjs",
    "add": "node scripts/add-module.mjs",
    "ai-pack": "node scripts/ai-pack.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "@capgo/capacitor-nfc": "^6.0.0",
    "usb-serial-plugin": "^0.0.9",
    "@capacitor-community/app-icon": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0"
  }
}
